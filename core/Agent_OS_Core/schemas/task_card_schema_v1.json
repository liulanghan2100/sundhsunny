{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "agent-os://schemas/task-card/v1",
  "title": "Agent OS TaskCard v1",
  "description": "统一任务契约。TaskCard 固化任务目标、Skill 选择、Policy 决策、执行边界、验收标准和失败策略。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "task_id",
    "project",
    "task_profile",
    "objective",
    "status",
    "selected_skill",
    "router_decision",
    "policy_decision",
    "execution_contract",
    "acceptance_criteria",
    "failure_policy",
    "expected_artifacts",
    "provenance",
    "created_at"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "agent-os-task-card-v1"
    },
    "task_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{2,127}$"
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "description": "Task Queue 内部关联 ID。"
    },
    "run_id": {
      "type": "string",
      "minLength": 1,
      "description": "Task Queue 对应的 RunState ID。"
    },
    "queue_task_id": {
      "type": "string",
      "minLength": 1,
      "description": "Task Queue 内部任务 ID。"
    },
    "project": {
      "type": "string",
      "minLength": 1
    },
    "task_profile": {
      "type": "string",
      "minLength": 1,
      "description": "用于 Router 选择 Skill 的稳定任务类别。"
    },
    "objective": {
      "type": "string",
      "minLength": 1
    },
    "risk_level": {
      "type": "string",
      "enum": [
        "low",
        "medium",
        "high",
        "critical"
      ],
      "default": "medium"
    },
    "risk_tier": {
      "type": "string",
      "enum": [
        "L1",
        "L2",
        "L3"
      ]
    },
    "intake": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "intake_id",
        "task_profile",
        "risk_rules",
        "effective_actions"
      ],
      "properties": {
        "intake_id": {
          "type": "string",
          "minLength": 1
        },
        "task_profile": {
          "type": "string",
          "minLength": 1
        },
        "risk_rules": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "effective_actions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "status": {
      "type": "string",
      "enum": [
        "queued",
        "pending_approval",
        "approved",
        "running",
        "retry",
        "blocked",
        "failed",
        "completed",
        "rejected"
      ]
    },
    "selected_skill": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "skill_id",
        "version",
        "content_hash"
      ],
      "properties": {
        "skill_id": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "description": "Skill 语义版本或本地版本标识。"
        },
        "content_hash": {
          "type": "string",
          "pattern": "^sha256:[0-9a-fA-F]{64}$"
        },
        "selection_reason": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "router_decision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "router_id",
        "router_version",
        "candidates",
        "selected_skill_id",
        "selection_reason",
        "decided_at"
      ],
      "properties": {
        "router_id": {
          "type": "string",
          "minLength": 1
        },
        "router_version": {
          "type": "string",
          "minLength": 1
        },
        "candidates": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "skill_id",
              "score",
              "rank",
              "reason"
            ],
            "properties": {
              "skill_id": {
                "type": "string",
                "minLength": 1
              },
              "score": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "rank": {
                "type": "integer",
                "minimum": 1
              },
              "reason": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "selected_skill_id": {
          "type": "string",
          "minLength": 1
        },
        "selection_reason": {
          "type": "string",
          "minLength": 1
        },
        "decided_at": {
          "type": "string",
          "format": "date-time"
        },
        "scope_hash": {
          "type": "string",
          "pattern": "^sha256:[0-9a-fA-F]{64}$"
        },
        "expires_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "conditions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "policy_decision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "decision",
        "policy_version",
        "rules_evaluated",
        "filtered_candidates",
        "reason",
        "decided_at"
      ],
      "properties": {
        "decision": {
          "type": "string",
          "enum": [
            "allow",
            "hold",
            "reject"
          ]
        },
        "policy_version": {
          "type": "string",
          "minLength": 1
        },
        "rules_evaluated": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "filtered_candidates": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "skill_id",
              "decision",
              "rule_id",
              "reason"
            ],
            "properties": {
              "skill_id": {
                "type": "string",
                "minLength": 1
              },
              "decision": {
                "type": "string",
                "enum": [
                  "allow",
                  "reject",
                  "hold"
                ]
              },
              "rule_id": {
                "type": "string",
                "minLength": 1
              },
              "reason": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "reason": {
          "type": "string",
          "minLength": 1
        },
        "decided_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "approval": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "decision",
        "decided_by",
        "decided_at",
        "decision_id"
      ],
      "properties": {
        "decision": {
          "type": "string",
          "enum": [
            "pending",
            "approve",
            "hold",
            "reject"
          ]
        },
        "decision_id": {
          "type": "string",
          "minLength": 1
        },
        "decided_by": {
          "type": "string",
          "minLength": 1
        },
        "decided_at": {
          "type": "string",
          "format": "date-time"
        },
        "reason": {
          "type": "string"
        }
      }
    },
    "execution_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "execution_mode",
        "allowed_tools",
        "allowed_paths",
        "blocked_paths",
        "allowed_actions",
        "forbidden_actions",
        "stop_conditions",
        "budget",
        "command"
      ],
      "properties": {
        "execution_mode": {
          "type": "string",
          "enum": [
            "plan_only",
            "validation",
            "synthetic_dry_run",
            "monkeypatched_provider",
            "local_read_only_tool",
            "real_provider_gated"
          ]
        },
        "allowed_tools": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "allowed_paths": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "blocked_paths": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "allowed_actions": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "forbidden_actions": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "stop_conditions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "command": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          },
          "description": "由批准方固化的 argv 参数数组，不接受未拆分的 shell 字符串。"
        },
        "budget": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "max_minutes",
            "max_cost_usd",
            "max_retries"
          ],
          "properties": {
            "max_minutes": {
              "type": "number",
              "minimum": 0.0166666667,
              "maximum": 60
            },
            "max_cost_usd": {
              "type": "number",
              "minimum": 0
            },
            "max_retries": {
              "type": "integer",
              "minimum": 0,
              "maximum": 3
            }
          }
        },
        "resource_locks": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "path",
              "access"
            ],
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1
              },
              "access": {
                "type": "string",
                "enum": [
                  "read",
                  "write"
                ]
              }
            }
          }
        }
      }
    },
    "acceptance_criteria": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "criterion_id",
          "description",
          "verifier",
          "required"
        ],
        "properties": {
          "criterion_id": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "verifier": {
            "type": "string",
            "minLength": 1
          },
          "required": {
            "type": "boolean"
          }
        }
      }
    },
    "failure_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "retryable_failure_types",
        "max_attempts",
        "on_exhaustion",
        "silent_fallback"
      ],
      "properties": {
        "retryable_failure_types": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "max_attempts": {
          "type": "integer",
          "minimum": 1
        },
        "on_exhaustion": {
          "type": "string",
          "enum": [
            "blocked",
            "failed",
            "owner_review"
          ]
        },
        "silent_fallback": {
          "type": "boolean",
          "const": false
        }
      }
    },
    "expected_artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "artifact_id",
          "path",
          "artifact_type",
          "required"
        ],
        "properties": {
          "artifact_id": {
            "type": "string",
            "minLength": 1
          },
          "path": {
            "type": "string",
            "minLength": 1
          },
          "artifact_type": {
            "type": "string",
            "minLength": 1
          },
          "required": {
            "type": "boolean"
          }
        }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source",
        "created_by"
      ],
      "properties": {
        "source": {
          "type": "string",
          "minLength": 1
        },
        "created_by": {
          "type": "string",
          "minLength": 1
        },
        "parent_task_id": {
          "type": "string"
        },
        "inbox_digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-fA-F]{64}$"
        }
      }
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "allOf": [
    {
      "if": {
        "required": [
          "status"
        ],
        "properties": {
          "status": {
            "enum": [
              "approved",
              "running",
              "retry",
              "completed"
            ]
          }
        }
      },
      "then": {
        "required": [
          "approval"
        ],
        "properties": {
          "policy_decision": {
            "properties": {
              "decision": {
                "const": "allow"
              },
              "filtered_candidates": {
                "contains": {
                  "type": "object",
                  "required": [
                    "decision"
                  ],
                  "properties": {
                    "decision": {
                      "const": "allow"
                    }
                  }
                }
              }
            }
          },
          "approval": {
            "properties": {
              "decision": {
                "const": "approve"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "required": [
          "execution_contract"
        ],
        "properties": {
          "execution_contract": {
            "required": [
              "execution_mode"
            ],
            "properties": {
              "execution_mode": {
                "const": "real_provider_gated"
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "risk_level": {
            "enum": [
              "high",
              "critical"
            ]
          },
          "approval": {
            "required": [
              "decision",
              "decided_by",
              "decided_at",
              "decision_id"
            ],
            "properties": {
              "decision": {
                "const": "approve"
              }
            }
          }
        }
      }
    }
  ]
}
